# Conexão direta ao Postgres — necessário para migrations
# Encontre em: Supabase Dashboard → Settings → Database → Connection string (URI)
# Use o "Transaction pooler" (porta 6543) ou "Session pooler" (porta 5432)
DATABASE_URL=postgresql://postgres:Deusefiel2002!@db.gqyxwglclpthkymztoia.supabase.co:5432/postgres

# WhisperX (roda local na GPU — sem API externa)
# Instalar após poetry install:
#   poetry run pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu121
#   poetry run pip install whisperx
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16   # float16 (GPU) | int8 (CPU/menos VRAM) | int8_float16
WHISPER_BATCH_SIZE=8           # reduzir se VRAM insuficiente
WHISPER_ALIGN=true             # timestamps word-level (recomendado)
WHISPER_DIARIZE=false          # identificação de speakers (requer HF_TOKEN)
HF_TOKEN=                      # HuggingFace token — só necessário se WHISPER_DIARIZE=true

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# ChromaDB (local)
CHROMA_PERSIST_DIR=./data/chroma

# Paths
OBSIDIAN_VAULT_PATH=

# Integrações não-sensíveis
NOTION_DATABASE_ID=
SLACK_DEFAULT_CHANNEL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
EMAIL_RECIPIENTS=

# LLM padrão
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.1:8b

# API Keys — prefira keyring; .env é fallback de desenvolvimento
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
NOTION_API_KEY=
SLACK_BOT_TOKEN=
SMTP_PASSWORD=
